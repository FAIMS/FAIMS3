# syntax=docker/dockerfile:1
# BASED ON https://turbo.build/repo/docs/guides/tools/docker

FROM node:24-alpine AS alpine

# Package to build (e.g., @faims3/api)
ARG PACKAGE_NAME
ENV PACKAGE_NAME=${PACKAGE_NAME}

# Directory relative to monorepo containing start entrypoint (optional)
ARG NODE_RUN_DIR
ENV NODE_RUN_DIR=${NODE_RUN_DIR}

# Memory limit to prevent V8 OOM during monorepo resolution
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Setup pnpm, bash, turbo and persistent store cache location
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"
RUN apk add --no-cache bash && \
    npm install -g pnpm@11.6.0 turbo@2.9.14 && \
    pnpm config set store-dir /pnpm/store

FROM alpine AS base

# PRUNE DEPENDENCIES [pruner]
FROM base AS pruner
WORKDIR /app
COPY . .
RUN turbo prune ${PACKAGE_NAME} --docker

# INSTALL PACKAGES & BUILD [builder]
FROM base AS builder
WORKDIR /app

COPY .gitignore .gitignore
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=pruner /app/out/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=pruner /app/out/json/ .

# Install dependencies using persistent cache mount
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline --config.minimumReleaseAge=0

COPY --from=pruner /app/out/full/ .
COPY --from=pruner /app/out/json/ json

# Build packages with Turbo cache mount
RUN --mount=type=cache,id=turbo,target=/app/.turbo \
    turbo run build --filter=${PACKAGE_NAME}

# Deploy standalone production application (pruned of devDependencies)
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm --filter=${PACKAGE_NAME} deploy --legacy --prod --prefer-offline --config.minimumReleaseAge=0 /app/deploy && \
    pkg_dir=$(pnpm --filter=${PACKAGE_NAME} exec pwd) && \
    if [ -d "$pkg_dir/dist" ]; then cp -r "$pkg_dir/dist" /app/deploy/; fi && \
    if [ -d "$pkg_dir/build" ]; then cp -r "$pkg_dir/build" /app/deploy/; fi && \
    if [ -d "$pkg_dir/views" ]; then cp -r "$pkg_dir/views" /app/deploy/; fi && \
    if [ -d "$pkg_dir/public" ]; then cp -r "$pkg_dir/public" /app/deploy/; fi && \
    if [ -f "scripts/generate-env-config.sh" ]; then cp scripts/generate-env-config.sh /app/deploy/; chmod +x /app/deploy/generate-env-config.sh; fi

# PRODUCTION RUNNER [runner]
FROM alpine AS runner

# Install GDAL tools for GeoPackage export if needed, plus Node.js & serve for static sites
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN apk add --no-cache gdal curl bash nodejs npm && \
    npm install -g serve

WORKDIR /app

# Non-root user (ID 33)
RUN deluser www-data 2>/dev/null || true && \
    delgroup www-data 2>/dev/null || true && \
    addgroup -g 33 -S faims && \
    adduser -u 33 -D -S -G faims faims && \
    mkdir -p /app && \
    chown -R 33:33 /app

COPY --chown=33:33 --from=builder /app/deploy /app

USER 33:33

EXPOSE 8000 3000 3001
CMD ["sh", "-c", "if [ -f ./generate-env-config.sh ]; then ./generate-env-config.sh dist; ./generate-env-config.sh build; fi; if [ -n \"$NODE_RUN_DIR\" ] && [ -d \"$NODE_RUN_DIR\" ]; then cd \"$NODE_RUN_DIR\" && node index.js; elif [ -f \"build/src/index.js\" ]; then node build/src/index.js; elif [ -d \"build\" ]; then serve -s build -l ${PORT:-3000}; elif [ -d \"dist\" ]; then serve -s dist -l ${PORT:-3000}; else node .; fi"]

