{
  "name": "@faims3/build-config",
  "version": "1.6.2",
  "private": true,
  "files": [
    "build"
  ],
  "type": "module",
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/src/index.js",
      "default": "./build/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf build",
    "generate": "tsx src/generate-build-config.ts",
    "migrate-aws": "tsx scripts/migrate-aws-config.ts",
    "test": "tsx --test test/*.test.ts",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "fix": "oxlint --config ../../.oxlintrc.json --fix . && oxfmt --config ../../.oxfmtrc.json ."
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@11.6.0"
}
