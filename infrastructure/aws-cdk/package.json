{
  "name": "@faims3/infra-aws-cdk",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build-src": "cd src && pnpm install && pnpm run build",
    "package": "cd src && pnpm run package",
    "init-api": "CONFIG_FILE_NAME=${CONFIG_FILE_NAME:-dev.json} && curl -X POST https://conductor.$(jq -r .hostedZone.name < \"configs/${CONFIG_FILE_NAME}\")/api/initialise",
    "watch": "tsc -w",
    "cdk": "cdk",
    "config": "bash ./config.sh",
    "validate-config": "tsx validateConfig.ts",
    "couch-upgrade-baseline": "tsx scripts/couchUpgradeBaseline.ts",
    "test": "jest",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "fix": "oxlint --config ../../.oxlintrc.json --fix . && oxfmt --config ../../.oxfmtrc.json ."
  },
  "dependencies": {
    "@cloudcomponents/cdk-static-website": "^2.2.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1148.0",
    "jest": "^29.7.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@11.6.0"
}
