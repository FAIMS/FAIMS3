{
  "core": {
    "branding": {
      "theme": "default",
      "appName": "FAIMS Mobile",
      "websiteTitle": "Control Centre",
      "conductorInstanceName": "FAIMS Server",
      "conductorDescription": "FAIMS Conductor instance deployment.",
      "conductorShortCodePrefix": "FAIMS"
    },
    "notebookAndRecordUX": {
      "notebookListType": "tabs",
      "notebookName": "notebook",
      "showStatusTab": true
    },
    "android": {
      "appId": "FAIMS"
    },
    "maps": {
      "mapSource": "maptiler",
      "mapSourceKey": "your-maptiler-api-key",
      "satelliteSource": "esri",
      "offlineMaps": true,
      "mapStyle": "basic",
      "autosuggestSource": "none"
    },
    "sync": {
      "forceRemoteDeletion": "never",
      "deleteOnDeactivation": false
    },
    "teamAndRolePolicy": {
      "excludedTeamRoles": ["TEAM_MEMBER_CREATOR"]
    },
    "webDesignerLimits": {
      "enablePlansInDesigner": true
    },
    "support": {
      "supportEmail": "support@your-domain.com",
      "privacyPolicyUrl": "https://your-domain.com/privacy-policy",
      "appContactUrl": "https://your-domain.com/contact",
      "docsUrl": "https://docs.your-domain.com"
    },
    "email": {
      "emailServiceType": "SMTP",
      "emailFromAddress": "notifications@your-domain.com",
      "emailFromName": "FAIMS Notification Service",
      "emailReplyTo": "support@your-domain.com",
      "testEmailAddress": "admin@your-domain.com",
      "smtpCacheExpirySeconds": 300
    },
    "auth": {
      "disableLocalLogin": false,
      "provisionSsoUsersPolicy": "reject"
    },
    "authProviders": {
      "google": {
        "id": "google",
        "type": "google",
        "index": 1,
        "displayName": "Google",
        "scope": ["profile", "email"]
      },
      "someOidcProvider": {
        "id": "someOidcProvider",
        "type": "oidc",
        "index": 2,
        "displayName": "OIDC Provider",
        "helperText": "Log in with your organization's OIDC provider.",
        "scope": ["openid", "profile", "email"],
        "issuer": "https://your-oidc-provider.com",
        "authorizationURL": "https://your-oidc-provider.com/authorize",
        "tokenURL": "https://your-oidc-provider.com/token",
        "userInfoURL": "https://your-oidc-provider.com/userinfo"
      },
      "someSamlProvider": {
        "id": "someSamlProvider",
        "type": "saml",
        "index": 3,
        "displayName": "Enterprise SSO",
        "signMetadata": true,
        "helperText": "Log in with your organization's identity provider.",
        "scope": ["profile", "email"],
        "entryPoint": "https://idp.example.com/saml2/sso",
        "issuer": "https://faims.example.com",
        "authnRequestBinding": "HTTP-POST",
        "callbackURL": "https://faims.example.com/auth/saml/callback",
        "signatureAlgorithm": "sha256",
        "digestAlgorithm": "sha256",
        "wantAssertionsSigned": true
      }
    },
    "authTokens": {
      "maximumLongLivedDurationDays": 90
    },
    "limits": {
      "rateLimiterEnabled": true,
      "attemptLimiterEnabled": true,
      "exportRateLimiterEnabled": true,
      "exportRateLimiterWindowMs": 600000,
      "exportRateLimiterPerWindow": 20
    },
    "observability": {
      "bugsnagApiKey": "1234-your-key"
    },
    "migration": {
      "disableMigrateOnStartup": false,
      "startupMigrationLockEnabled": true,
      "startupMigrationLockTimeoutMs": 1800000
    },
    "endpoints": {
      "androidAppPublicUrl": "https://play.google.com/store/apps/details?id=your.android.app.id",
      "iosAppPublicUrl": "https://apps.apple.com/app/your-ios-app-id"
    },
    "secrets": {
      "auth": {
        "authProviders": {}
      }
    }
  },
  "aws": {
    "stackName": "FaimsInfraStack",
    "hostedZone": {
      "id": "your-hosted-zone-id",
      "name": "your-domain.com"
    },
    "certificates": {
      "primary": "arn:aws:acm:region:account-id:certificate/certificate-id",
      "cloudfront": "arn:aws:acm:us-east-1:account-id:certificate/certificate-id"
    },
    "account": "your-aws-account-id",
    "region": "ap-southeast-2",
    "secrets": {
      "privateKey": "arn:aws:secretsmanager:region:account-id:secret:private-key-secret-id",
      "publicKey": "arn:aws:secretsmanager:region:account-id:secret:public-key-secret-id"
    },
    "smtpCredentialsSecretArn": "arn:aws:secretsmanager:region:account-id:secret:smtp-credentials-id",
    "couch": {
      "ebsRecoverySnapshotId": "1234",
      "volumeSize": 20,
      "instanceType": "t3.small",
      "monitoring": {
        "cpu": {
          "threshold": 80,
          "evaluationPeriods": 3,
          "datapointsToAlarm": 2
        },
        "memory": {
          "threshold": 80,
          "evaluationPeriods": 3,
          "datapointsToAlarm": 2
        },
        "disk": {
          "threshold": 80,
          "evaluationPeriods": 3,
          "datapointsToAlarm": 2
        },
        "statusCheck": {
          "evaluationPeriods": 2,
          "datapointsToAlarm": 2
        },
        "networkIn": {
          "threshold": 10000000,
          "evaluationPeriods": 3,
          "datapointsToAlarm": 2
        },
        "networkOut": {
          "threshold": 10000000,
          "evaluationPeriods": 3,
          "datapointsToAlarm": 2
        },
        "http5xx": {
          "threshold": 10,
          "evaluationPeriods": 5,
          "datapointsToAlarm": 3
        },
        "alarmTopic": {
          "emailAddress": "fake@gmail.com"
        }
      }
    },
    "backup": {
      "vaultName": "faims-backup-vault",
      "retentionDays": 30,
      "scheduleExpression": "cron(0 3 * * ? *)"
    },
    "ttlCleanup": {
      "enabled": false,
      "scheduleExpression": "cron(0 2 * * ? *)",
      "scheduleExpressionTimezone": "Australia/Sydney",
      "dryRun": false,
      "compact": false,
      "includeLongLived": false,
      "deleteExhaustedInvites": false,
      "cpu": 256,
      "memory": 512
    },
    "conductor": {
      "enhancedObservability": true,
      "conductorDockerImage": "ghcr.io/faims/faims3-api",
      "conductorDockerImageTag": "latest",
      "cpu": 1024,
      "memory": 2048,
      "autoScaling": {
        "desiredCapacity": 2,
        "minCapacity": 1,
        "maxCapacity": 10,
        "targetCpuUtilization": 70,
        "targetMemoryUtilization": 70,
        "scaleInCooldown": 300,
        "scaleOutCooldown": 60
      },
      "localhostWhitelist": false
    },
    "authProviders": {
      "providers": ["google", "someOidcProvider", "someSamlProvider"],
      "secretArn": "arn:aws:secretsmanager:region:account-id:secret:auth-providers-credentials-id"
    },
    "domains": {
      "baseDomain": "your-domain.com",
      "conductor": "conductor",
      "couch": "couchdb",
      "faims": "faims",
      "web": "web",
      "docs": "docs"
    }
  }
}
