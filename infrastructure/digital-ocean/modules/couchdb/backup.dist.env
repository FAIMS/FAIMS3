# CouchDB Backup Configuration
# Copy this file to /opt/couchdb/backup.env and fill in your values

# REQUIRED: CouchDB data directory
COUCHDB_DATA_DIR=/mnt/couchdb/data

# REQUIRED: Digital Ocean Spaces configuration
DO_SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
DO_SPACES_BUCKET=fieldmark.app.backup

# Access key and secret for S3-compatible storage
# needs to have sufficient access to create new buckets and objects
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>


# REQUIRED: Restic repository password
# Generate a strong password and store it securely!
RESTIC_PASSWORD=<your-restic-password>

# OPTIONAL: Retention policy (defaults shown)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# OPTIONAL: Backup metadata
BACKUP_TAG=couchdb-backup
LOG_DIR=/var/log/couchdb-backup

# OPTIONAL: Notifications (leave empty to disable)
NOTIFY_EMAIL=
NOTIFY_WEBHOOK=
