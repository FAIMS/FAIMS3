; CouchDB Configuration Settings for FAIMS

[couchdb]
max_document_size = 4294967296 ; bytes
; CouchDB 3.5 defaults this to 1 GiB; map-layer originals can be 2 GiB.
max_attachment_size = 4294967296 ; bytes
os_process_timeout = 5000 ; 5 sec
uuid = <UUID_PLACEHOLDER>

[chttpd]
port = 5984
bind_address = 0.0.0.0
max_http_request_size = 4294967296 ; 4 GiB
authentication_handlers = {chttpd_auth, cookie_authentication_handler}, {chttpd_auth, jwt_authentication_handler}, {chttpd_auth, default_authentication_handler}

[httpd]
enable_cors = true

[couchdb]
single_node=true

[log]
writer = syslog
level = info

[chttpd_auth]
secret = <SECRET_PLACEHOLDER>

[cors]
origins = *
headers = accept, authorization, content-type, origin, referer
credentials = true
methods = GET, PUT, POST, HEAD, DELETE

[jwt_auth]
required_claims = exp
