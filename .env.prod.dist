# FAIMS3 Production Environment Configuration Template
# Copy this file to .env.prod and update values before starting containers:
#   cp .env.prod.dist .env.prod

# Container Images (Use specific version tags or SHA in production)
API_IMAGE=ghcr.io/faims/faims3-api:latest
WEB_IMAGE=ghcr.io/faims/faims3-web:latest
APP_IMAGE=ghcr.io/faims/faims3-app:latest
COUCHDB_IMAGE=couchdb:3

# Network Binds (Defaults to 127.0.0.1 for security behind reverse proxy)
CONDUCTOR_BIND_IP=127.0.0.1
CONDUCTOR_EXTERNAL_PORT=8080
COUCHDB_BIND_IP=127.0.0.1
COUCHDB_EXTERNAL_PORT=5984
WEB_BIND_IP=127.0.0.1
WEB_EXTERNAL_PORT=3001
APP_BIND_IP=127.0.0.1
APP_EXTERNAL_PORT=3000

# Public URLs (Replace with your actual domain names with HTTPS)
CONDUCTOR_PUBLIC_URL=https://api.example.com
COUCHDB_PUBLIC_URL=https://db.example.com
WEB_APP_PUBLIC_URL=https://app.example.com
DESIGNER_URL=https://web.example.com
NEW_CONDUCTOR_URL=https://web.example.com

# Instance Information
PROFILE_NAME=production
CONDUCTOR_INSTANCE_NAME="FAIMS Production Server"
CONDUCTOR_DESCRIPTION="FAIMS Fieldmark Production Instance"
CONDUCTOR_SHORT_CODE_PREFIX="PROD"

# CouchDB Admin Credentials
COUCHDB_USER=admin
# REPLACE WITH SECURE RANDOM PASSWORD (e.g., openssl rand -hex 24)
COUCHDB_PASSWORD=CHANGE_ME_SECURE_COUCHDB_PASSWORD

# Security & Session Secrets
# REPLACE WITH SECURE RANDOM UUID/HEX (e.g., uuidgen or openssl rand -hex 32)
FAIMS_COOKIE_SECRET=CHANGE_ME_SECURE_COOKIE_SECRET

# Key Management (FILE, ENV, or AWS_SM)
KEY_SOURCE=FILE
KEY_FILE_PATH=.

# Token Expirations (Minutes)
REFRESH_TOKEN_EXPIRY_MINUTES=2880
ACCESS_TOKEN_EXPIRY_MINUTES=5

# Authentication Policies
DISABLE_LOCAL_LOGIN=false
PROVISION_SSO_USERS_POLICY=reject
REDIRECT_WHITELIST=https://api.example.com,https://web.example.com,https://app.example.com,https://designer.example.com,org.fedarch.faims3://auth-return

# Security & Rate Limiting
RATE_LIMITER_ENABLED=true
AUTH_ATTEMPT_LIMITER_ENABLED=true
RATE_LIMITER_WINDOW_MS=600000
RATE_LIMITER_PER_WINDOW=1000

# Email Service Configuration (SMTP)
EMAIL_SERVICE_TYPE=SMTP
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME="FAIMS Notifications"
EMAIL_REPLY_TO=support@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=smtp_user
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
