<h2>Database Setup Error</h2>

<p>The database is not set up properly. You might be able to fix the problem 
  from this page.</p>

<p>COUCHDB URL: <a href="{{couchdb_url}}">{{couchdb_url}}</a></p>

{{#if canReachServer}}
  <p>Able to connect to database server.</p>

  {{#if missingDatabases.length}}
  <ul>
  {{#each missingDatabases}}
  <li>Database {{this}} not found</li>
  {{/each}}
  </ul>
  {{/if}}

  {{#if unreachableDatabases.length}}
  <ul>
  {{#each unreachableDatabases}}
  <li>Unable to connect to database {{this}}</li>
  {{/each}}
  </ul>
  {{/if}}

  <form action="/fallback-initialise" method="POST">
    <input type="submit" value="Run Database Initialisation">
  </form>
  
{{else}}
  <p>Unable to connect to the database server.</p>
{{/if}}
