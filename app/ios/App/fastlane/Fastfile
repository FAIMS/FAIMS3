
default_platform(:ios)

VITE_APPLE_BUNDLE_IDENTIFIER = ENV["VITE_APPLE_BUNDLE_IDENTIFIER"]
APPLE_ISSUER_ID = ENV["APPLE_ISSUER_ID"]
APPLE_KEY_ID = ENV["APPLE_KEY_ID"]
APPLE_KEY_CONTENT = ENV["APPLE_KEY_CONTENT"].to_s.gsub('\\n', "\n").strip
GIT_AUTHORIZATION = ENV["GIT_AUTHORIZATION"]


# keychain details are hard-coded here with a generated password
KEYCHAIN_NAME = "keychain"
KEYCHAIN_PASSWORD = SecureRandom.hex(32) 

def delete_temp_keychain()
  delete_keychain(
    name: KEYCHAIN_NAME
  ) if File.exist? File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")
end

def ensure_temp_keychain()
  delete_temp_keychain()
  create_keychain(
    name: KEYCHAIN_NAME,
    password: KEYCHAIN_PASSWORD,
    unlock: false,
    timeout: 0
  )
end

# Prefer PROVISIONING_PROFILE_SPECIFIER when set (custom Match profile names);
# otherwise the standard Match App Store name for this bundle id.
# Xcode project profile name is set in prebuildIOS.sh; this is for gym export.
def appstore_profile_specifier
  custom = ENV["PROVISIONING_PROFILE_SPECIFIER"].to_s.strip
  return custom unless custom.empty?
  "match AppStore #{VITE_APPLE_BUNDLE_IDENTIFIER}"
end

platform :ios do

  lane :closed_beta_testflight do
    ensure_temp_keychain()

    api_key = app_store_connect_api_key(
      key_id: APPLE_KEY_ID,
      issuer_id: APPLE_ISSUER_ID,
      key_content: APPLE_KEY_CONTENT,
      duration: 1200,
      in_house: false
    )

    #increment_build_number(xcodeproj: "App.xcodeproj")
    #handled by script and xcode in build phases, I hope.

    cocoapods(
      clean_install: true
    )

    match(
      type: 'appstore',
      storage_mode: "git",
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64(ENV["GIT_AUTHORIZATION"]),
      readonly: false,
      keychain_name: KEYCHAIN_NAME,
      keychain_password: KEYCHAIN_PASSWORD,
      api_key: api_key
    )

    update_project_team(
      path: "App.xcodeproj",
      teamid: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
    )

    gym(
      configuration: "Release", #make sure this key matches xcode signing and capabilities.
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
            VITE_APPLE_BUNDLE_IDENTIFIER => appstore_profile_specifier
        },
        teamID: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
      }
    )
    changelog = changelog_from_git_commits(
      match_lightweight_tag: false,
      merge_commit_filtering: "exclude_merges"
    )

    puts "Deploying to TestFlight with app identifier: #{VITE_APPLE_BUNDLE_IDENTIFIER}"

    UI.user_error!("Missing app identifier for TestFlight deploy") if VITE_APPLE_BUNDLE_IDENTIFIER.to_s.empty?

    pilot(
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      ipa: "App.ipa",
      changelog: changelog
    )

    delete_temp_keychain()
  end

  lane :production do
    ensure_temp_keychain()

    api_key = app_store_connect_api_key(
      key_id: APPLE_KEY_ID,
      issuer_id: APPLE_ISSUER_ID,
      key_content: APPLE_KEY_CONTENT,
      duration: 1200,
      in_house: false
    )

    #increment_build_number(xcodeproj: "App.xcodeproj")
    #handled by script and xcode in build phases, I hope.

    cocoapods(
      clean_install: true
    )

    match(
      type: 'appstore',
      storage_mode: "git",
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64(ENV["GIT_AUTHORIZATION"]),
      readonly: false,
      keychain_name: KEYCHAIN_NAME,
      keychain_password: KEYCHAIN_PASSWORD,
      api_key: api_key
    )

    update_project_team(
      path: "App.xcodeproj",
      teamid: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
    )

    gym(
      configuration: "Release", #make sure this key matches xcode signing and capabilities.
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
            VITE_APPLE_BUNDLE_IDENTIFIER => appstore_profile_specifier
        },
        teamID: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
      }
    )

    deliver(
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      ipa: "App.ipa",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )

    delete_temp_keychain()
  end

  # Individual App Store Connect API key + readonly match.
  # Match only fetches existing certs/profiles (no provisioning API). Renew
  # certs outside CI with a Team key / Admin account.
  # Omitting issuer_id makes Fastlane treat the key as individual.
  # Requires fastlane >= 2.233 for Individual-key altool uploads (no Apple ID / ASP).
  # apple_id here is the numeric ASC app id; with skip_waiting_for_build_processing
  # pilot stays non-interactive on CI.
  lane :closed_beta_testflight_individual do
    ensure_temp_keychain()

    app_store_connect_api_key(
      key_id: APPLE_KEY_ID,
      key_content: APPLE_KEY_CONTENT,
      duration: 1200,
      in_house: false
    )

    cocoapods(
      clean_install: true
    )

    match(
      type: 'appstore',
      storage_mode: "git",
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64(ENV["GIT_AUTHORIZATION"]),
      readonly: true,
      keychain_name: KEYCHAIN_NAME,
      keychain_password: KEYCHAIN_PASSWORD
    )

    update_project_team(
      path: "App.xcodeproj",
      teamid: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
    )

    gym(
      configuration: "Release",
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
            VITE_APPLE_BUNDLE_IDENTIFIER => appstore_profile_specifier
        },
        teamID: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
      }
    )
    changelog = changelog_from_git_commits(
      match_lightweight_tag: false,
      merge_commit_filtering: "exclude_merges"
    )

    pilot(
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      ipa: "App.ipa",
      changelog: changelog
    )

    delete_temp_keychain()
  end

  # Same Individual-key constraints as closed_beta_testflight_individual.
  lane :production_individual do
    ensure_temp_keychain()

    app_store_connect_api_key(
      key_id: APPLE_KEY_ID,
      key_content: APPLE_KEY_CONTENT,
      duration: 1200,
      in_house: false
    )

    cocoapods(
      clean_install: true
    )

    match(
      type: 'appstore',
      storage_mode: "git",
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: Base64.strict_encode64(ENV["GIT_AUTHORIZATION"]),
      readonly: true,
      keychain_name: KEYCHAIN_NAME,
      keychain_password: KEYCHAIN_PASSWORD
    )

    update_project_team(
      path: "App.xcodeproj",
      teamid: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
    )

    gym(
      configuration: "Release",
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
            VITE_APPLE_BUNDLE_IDENTIFIER => appstore_profile_specifier
        },
        teamID: ENV["VITE_APP_STORE_CONNECT_TEAM_ID"]
      }
    )

    deliver(
      app_identifier: "#{VITE_APPLE_BUNDLE_IDENTIFIER}",
      ipa: "App.ipa",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false
    )

    delete_temp_keychain()
  end
end
